# ─── DespachaGov — variáveis de ambiente ─────────────────────────────────────
# Copie para .env.local e preencha. .env.local é git-ignored — nunca commitar.
# Apenas chaves PÚBLICAS (prefixo VITE_) vão pro frontend.

# Supabase (frontend — públicas)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps (frontend — pública, restringida por Referer no Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=
# Map ID exigido pelo AdvancedMarkerElement (substituto do Marker legado).
# Se ausente, o app usa DEMO_MAP_ID (bom p/ dev, não recomendado em prod).
# Crie em: Google Cloud Console → Maps Platform → Map Management.
VITE_GOOGLE_MAPS_MAP_ID=

# ─── SEGREDOS — NÃO usar prefixo VITE_, NÃO expor no frontend ────────────────
# Vivem só como secrets de Edge Function (supabase secrets set ...).
# Listados aqui apenas como referência de quais chaves existem.
#   SUPABASE_SERVICE_ROLE_KEY=
#   ANTHROPIC_API_KEY=
#   RESEND_API_KEY=
#   NOTIFY_WEBHOOK_SECRET=   (conferido por notify-event contra o header x-notify-secret)
#   GOOGLE_MAPS_API_KEY=     (geocode server-side; restrição "Nenhuma" no Google Cloud)
#
# Remetente dos e-mails transacionais enviados via Resend. Opcional — se ausente,
# usa "DespachaGov <nao-responder@despachagov.com>". O domínio precisa estar
# VERIFICADO no Resend (SPF/DKIM), senão a API aceita e a entrega falha depois.
# ATENÇÃO: os e-mails do Supabase Auth (confirmação / recuperação / magic link)
# NÃO passam por aqui — saem pelo SMTP configurado no painel. Alinhe os dois.
#   EMAIL_FROM="DespachaGov <nao-responder@despachagov.com>"
